---
# Code style for this project.
#
# Configure your IDE to use "clang-format"; the exact steps differ per IDE. LLVM ships it, and
# Visual Studio bundles a copy at VC\Tools\Llvm\x64\bin\clang-format.exe.
# Options reference: https://clang.llvm.org/docs/ClangFormatStyleOptions.html
#
#
UseTab: Never
TabWidth: '4'
IndentWidth: '4'
BasedOnStyle: Google
AccessModifierOffset: -4
ColumnLimit: 120
NamespaceIndentation: All
IndentPPDirectives: BeforeHash
FixNamespaceComments: false

# namespace / function / class break; if / for / while stay attached.
BreakBeforeBraces: Linux

# `if (!player) return 10;` stays on one line, but never with an else.
AllowShortIfStatementsOnASingleLine: WithoutElse

# Never fold a function body onto its signature, even a one-line getter.
AllowShortFunctionsOnASingleLine: None

# Keep multi-line lambdas as written.
AllowShortLambdasOnASingleLine: None

# `int x{ 0 }` rather than `int x{0}`, matching the member initialisers throughout.
Cpp11BracedListStyle: false

# `RE::TESGlobal* ptr`, not `RE::TESGlobal *ptr`.
PointerAlignment: Left

# PCH.h has to stay first, so leave include order alone.
SortIncludes: false

# One comment, one line. ColumnLimit applies to code only; without this clang-format would rewrap
# every comment back to 120 columns.
ReflowComments: false

...
